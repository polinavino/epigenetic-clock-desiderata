# Data files — too large for git, downloaded by script
data/
data/*.csv
data/*.txt
data/*.gz
data/*.h5
data/*.parquet
data/raw/

# Python
__pycache__/
*.pyc
*.pyo
.env
venv/

# LaTeX build artifacts (any paper subdirectory)
**/*.aux
**/*.log
**/*.out
**/*.bbl
**/*.blg
**/*.fls
**/*.fdb_latexmk
**/*.synctex.gz
**/*.toc

# Compiled PDFs — comment out if you want to track these
**/main.pdf

# OS
.DS_Store

# VSCode
.vscode/

# eye_aging instance: the data/ rule above also hides eye_aging/data, so re-include it and keep the
# small derived/source tables (metadata, eye_scores, gene sets, symbol map) plus the 5.9 MB counts
# parquet so eye_clocks.py reruns from a clean clone. Ignore only the redundant 13 MB counts CSV.
!eye_aging/data/
eye_aging/data/GSE314970_rat_retina_counts.csv